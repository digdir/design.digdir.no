{
  "$schema": "https://designsystemet.no/schemas/config/1.24.0.json",
  "output": [
    {
      "type": "design-tokens",
      "dir": "./design-tokens-ki-norge",
      "cleanDir": true
    },
    {
      "type": "css",
      "dir": "./css",
      "tokensDir": "./design-tokens-ki-norge"
    },
    {
      "type": "types",
      "dir": "./css",
      "tokensDir": "./design-tokens-ki-norge"
    }
  ],
  "themes": {
    "ki-norge": {
      "colors": {
        "accent": "#B42946",
        "brand1": "#A24D83",
        "brand2": "#89634A",
        "brand3": "#E9B596",
        "brand4": "#F5898D",
        "neutral": "#24272B"
      },
      "overrides": {
        "colors": {
          "accent": {
            "background-tinted": {
              "light": "#EEBBC1"
            },
            "background-default": {
              "light": "#F8F3EE"
            },
            "surface-default": {
              "light": "#F8F3EE"
            }
          },
          "brand1": {
            "background-tinted": {
              "light": "#D0ADC3"
            },
            "background-default": {
              "light": "#F8F3EE"
            },
            "surface-default": {
              "light": "#F8F3EE"
            }
          },
          "brand2": {
            "background-tinted": {
              "light": "#BA9F8E"
