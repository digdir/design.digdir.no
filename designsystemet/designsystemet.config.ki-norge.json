            "surface-default": {
              "light": "#FDF9F5"
            }
          },
          "brand3": {
            "background-tinted": {
              "light": "#FCC9A9"
            },
            "background-default": {
              "light": "#F8F3EE"
            },
            "surface-default": {
              "light": "#F8F3EE"
            }
          },
          "brand4": {
            "background-tinted": {
              "light": "#EEBBBB"
            },
            "background-default": {
              "light": "#F8F3EE"
            },
            "surface-default": {
              "light": "#F8F3EE"
