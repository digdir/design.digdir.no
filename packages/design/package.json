{
  "name": "@digdir/design",
  "version": "0.0.1",
  "description": "Illustrations and component styles for Digdir's visual profiles, built on Designsystemet.",
  "type": "module",
  "license": "ISC",
  "author": "digdir",
  "repository": {
    "type": "git",
    "url": "https://github.com/felleslosninger/varde",
    "directory": "packages/design"
  },
  "keywords": [
    "svg",
    "illustrations",
    "dark-mode",
    "react",
    "digdir"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./illustrations": {
      "types": "./dist/illustrations/index.d.ts",
      "default": "./dist/illustrations/index.js"
    },
    "./illustrations.css": "./dist/illustrations/index.css",
    "./illustrations/*/react": {
      "types": "./dist/illustrations/*/react/index.d.ts",
      "default": "./dist/illustrations/*/react/index.js"
    },
    "./illustrations/*/svg": {
      "types": "./dist/illustrations/*/svg.d.ts",
      "default": "./dist/illustrations/*/svg.js"
    },
    "./illustrations/*/meta": {
      "types": "./dist/illustrations/*/meta.d.ts",
      "default": "./dist/illustrations/*/meta.js"
    },
    "./illustrations/*/images": {
      "types": "./dist/illustrations/*/images.d.ts",
      "default": "./dist/illustrations/*/images.js"
    },
    "./illustrations/*.css": "./dist/illustrations/*.css",
    "./components.css": "./dist/components/index.css",
    "./components/*.css": "./dist/components/*.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && node scripts/build-illustrations.ts && node scripts/build-components.ts && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist generated",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
